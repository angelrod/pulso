{
  "name": "pulso",
  "version": "0.1.0",
  "private": true,
  "description": "See what your Mac is spending, and quit it, from the menu bar.",
  "author": "Miguel Angel Rod",
  "license": "MIT",
  "homepage": "https://github.com/angelrod/pulso",
  "repository": {
    "type": "git",
    "url": "https://github.com/angelrod/pulso.git"
  },
  "bugs": {
    "url": "https://github.com/angelrod/pulso/issues"
  },
  "main": "out/main/index.js",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:comments": "node scripts/check-comments.mjs",
    "verify": "sh scripts/verify.sh",
    "preview:panel": "node scripts/preview-panel.mjs",
    "dist": "electron-vite build && electron-builder --mac --arm64"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
